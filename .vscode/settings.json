{
  "editor.formatOnSave": true,
  "editor.rulers": [120],
  "[rust]": { "editor.defaultFormatter": "rust-lang.rust-analyzer" },
  "[markdown]": { "editor.formatOnSave": false, "editor.rulers": [80] },
  "[toml]": { "editor.defaultFormatter": "tombi-toml.tombi" },

  // Rust: Clippy on save; rust-analyzer builds in its own folder (target/rust-analyzer)
  // so it never blocks or invalidates `cargo build` and `cargo test`.
  "rust-analyzer.check.command": "clippy",
  "rust-analyzer.cargo.targetDir": true,

  // Keep build outputs and scratch data out of search and the file watcher.
  "search.exclude": {
    "**/target": true,
    "tmp": true,
    "Cargo.lock": true
  },
  "files.watcherExclude": {
    "**/target/**": true,
    "tmp/**": true
  },
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true
}
